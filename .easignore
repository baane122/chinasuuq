# Root EAS ignore for the ChinaSuuq monorepo.
# EAS archives from the repo root when building a workspace sub-app,
# so the ignore here must cover ALL heavy/non-source paths.
node_modules
**/node_modules
**/node_modules/**
.next
**/.next
**/out
**/dist
**/build
**/coverage
.expo
**/.expo
**/.expo-shared
.git
.gitignore
.DS_Store
*.log
*.tsbuildinfo
.github
**/.vercel
.vercel
**/android/build
**/ios/Pods
**/web-build
apps/web/node_modules
packages/*/node_modules
