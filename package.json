{
  "name": "chinasuuq",
  "private": true,
  "packageManager": "npm@10.9.0",
  "workspaces": [
    "apps/web",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "cd apps/web && npm run dev",
    "dev:mobile": "cd apps/mobile && npx expo start",
    "build": "cd apps/web && npm run build",
    "typecheck": "cd apps/web && npx tsc --noEmit",
    "lint": "turbo lint",
    "clean": "turbo clean",
    "verify:roles": "node --experimental-strip-types scripts/verify-role-vocabulary.mjs"
  },
  "devDependencies": {
    "turbo": "^2.0.0"
  },
  "version": "0.0.1"
}
