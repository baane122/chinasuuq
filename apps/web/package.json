{
  "name": "chinasuuq",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "verify:joins": "node --experimental-strip-types --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/verify-batched-join.mjs",
    "verify:ai": "node --experimental-strip-types --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/verify-ai-client.mjs",
    "verify:track": "node --experimental-strip-types --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/verify-track-errors.mjs",
    "verify:admin": "node --experimental-strip-types --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/verify-admin-guardrails.mjs",
    "verify": "npm run verify:schema && npm run verify:contract && npm run verify:apk && npm run verify:joins && npm run verify:ai && npm run verify:track && npm run verify:admin",
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "verify:schema": "node scripts/verify-schema-contract.mjs",
    "verify:contract": "node scripts/verify-contract.mjs",
    "refresh:contract": "./scripts/refresh-contract-snapshot.sh",
    "verify:apk": "node scripts/verify-apk-freshness.mjs",
    "apk:stamp": "node scripts/stamp-apk.mjs",
    "test:e2e": "playwright test",
    "test:e2e:live": "BASE_URL=https://chinasuuq.com playwright test",
    "serve:export": "node scripts/serve-export.mjs --port 4317 --dir out",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test": "npm run test:unit && npm run test:e2e"
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.3.3",
    "@supabase/supabase-js": "^2.111.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.43.0",
    "lucide-react": "^1.28.0",
    "next": "^16.2.12",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "tailwind-merge": "^3.6.0",
    "zod": "^3.25.76",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.2.12",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^3.2.7"
  },
  "optionalDependencies": {
    "@tailwindcss/oxide": "^4.0.0",
    "@tailwindcss/oxide-linux-x64-gnu": "^4.0.0",
    "lightningcss-linux-x64-gnu": "^1.32.0"
  }
}
