{
  "expo": {
    "name": "ChinaSuuq",
    "slug": "chinasuuq-mobile",
    "scheme": "chinasuuq",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "userInterfaceStyle": "light",
    "backgroundColor": "#FFFCF8",
    "primaryColor": "#FF5A0A",
    "description": "Order products from China to Somalia. Browse 1688, Taobao and YiwuGo with live translation, CNY-to-USD conversion, and a unified cart. Air or sea freight to Hargeisa, Mogadishu, Bosaso and more.",
