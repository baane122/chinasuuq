      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#FFFCF8"
      },
      "package": "com.chinasuuq.app",
      "versionCode": 1,
      "permissions": [
        "INTERNET"
      ]
    },
