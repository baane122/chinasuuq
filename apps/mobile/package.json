{
  "name": "chinasuuq-mobile",
  "version": "1.0.5",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start --go",
    "start:go": "expo start --go",
    "start:dev-client": "expo start --dev-client",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "tsc": "tsc --noEmit",
    "postinstall": "node scripts/fix-jcenter.js",
    "verify:webview": "node scripts/verify-cs-runtime.mjs",
    "verify:translate": "node --experimental-strip-types scripts/verify-translate-client.mjs",
    "verify:translate-inpage": "node --experimental-strip-types scripts/verify-translate-inpage.mjs",
    "verify:usd": "node --experimental-strip-types scripts/verify-usd-inpage.mjs",
    "verify:inbatches": "node --experimental-strip-types --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/verify-in-batches.mjs",
    "verify:session": "node --experimental-strip-types --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/verify-marketplace-session.mjs",
    "verify:states": "node --experimental-strip-types --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/verify-cart-and-states.mjs",
    "verify:authurl": "node --experimental-strip-types --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/verify-auth-url.mjs",
    "verify": "npm run tsc && npm run verify:webview && npm run verify:translate && npm run verify:translate-inpage && npm run verify:usd && npm run verify:inbatches && npm run verify:session && npm run verify:states && npm run verify:authurl"
  },
  "dependencies": {
    "@expo-google-fonts/inter": "^0.4.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-cookies/cookies": "^6.2.1",
    "@supabase/supabase-js": "^2.111.0",
    "expo": "~58.0.21",
    "expo-asset": "~58.0.19",
    "expo-constants": "~58.0.14",
    "expo-dev-client": "~58.0.17",
    "expo-font": "~58.0.11",
    "expo-haptics": "~58.0.7",
    "expo-image": "~58.0.18",
    "expo-linear-gradient": "~58.0.3",
    "expo-linking": "~58.0.15",
    "expo-router": "~58.0.28",
    "expo-secure-store": "~58.0.2",
    "expo-splash-screen": "~58.0.12",
    "expo-status-bar": "~58.0.4",
    "expo-updates": "~58.0.19",
    "lucide-react-native": "^0.468.0",
    "querystring-es3": "^0.2.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-view-shot": "6.1.1",
    "react-native-web": "~0.21.4",
    "react-native-webview": "14.0.1",
    "react-native-worklets": "0.13.0",
    "react-refresh": "^0.14.2",
    "stream-browserify": "^3.0.0",
    "zod": "^3.24.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.0",
    "@types/react": "~19.3.0",
    "babel-preset-expo": "~58.0.22",
    "typescript": "~6.0.3"
  },
  "private": true
}
