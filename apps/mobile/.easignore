# EAS build upload ignore — this drastically shrinks the upload archive.
# node_modules is NOT uploaded; EAS installs dependencies on its own servers.
node_modules
**/node_modules

# Local / build artifacts
.git
.gitignore
.expo
.expo-shared
.DS_Store
*.log
*.tsbuildinfo
android/build
android/app/build

# Not needed as build inputs (regenerated by expo prebuild / installed remotely)
yarn.lock
package-lock.json
npm-debug.log*

# Vercel / web-specific (irrelevant to the mobile build)
.vercel
