# EAS build upload ignore — this shrinks the upload archive.
# NOTE: the archive has stayed ~226 MB with these rules in place, so this list does
# not actually keep node_modules out; see doc.md §12 before assuming it does.
node_modules
**/node_modules

# Local / build artifacts
.git
.gitignore
.expo
.expo-shared
.DS_Store
*.log
*.tsbuildinfo
android/build
android/app/build

# Build inputs that must remain available
# Keep package-lock.json for reproducible EAS installs.

# Vercel / web-specific (irrelevant to the mobile build)
.vercel

# Generated / build outputs — EAS prebuilds and bundles its own
dist
ios
android
web-build
